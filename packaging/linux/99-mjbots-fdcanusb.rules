# mjbots fdcanusb (legacy CDC firmware) and mjcanfd-usb / new fdcanusb (gs_usb + CDC)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0660", GROUP="dialout", SYMLINK+="fdcanusb"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="2323", MODE="0660", GROUP="dialout", SYMLINK+="fdcanusb"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="2323", MODE="0660", GROUP="dialout"
